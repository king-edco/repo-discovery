# GitHub personal access token (needs public_repo / repo scope for search + contents)
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Currents API key (free tier, 250 requests/day) for the demand-signal ingestion.
# Create one at https://currentsapi.services/
CURRENTS_API_KEY=your_currents_api_key_here

# Google Gemini API key (OPTIONAL). When set, the repo enrichment (plain-language
# summary + business pitch) is generated via Gemini 2.0 Flash for higher quality.
# When unset, a heuristic generator is used instead — the app works without a key.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Admin key for privileged API operations (OPTIONAL but recommended in prod).
# Required to force-regenerate repo enrichments (?force=1), which spends paid
# Gemini quota — without this key set, force-regeneration is always denied.
# Send it as the `x-admin-key` request header.
ENRICHMENT_ADMIN_KEY=

# ─── Auth (Better Auth) ────────────────────────────────────────────────────
# Secret used to sign session cookies/tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (used for OAuth callbacks and absolute links).
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (OPTIONAL — email/password auth works without them).
# GitHub: https://github.com/settings/developers (callback: {BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials (callback: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Billing (Stripe, OPTIONAL — app runs without it, upgrade shows a notice) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the Pro plan (recurring monthly price, e.g. price_...).
STRIPE_PRO_PRICE_ID=

# ─── Email (Resend, OPTIONAL — feedback forwarding + transactional emails) ───
RESEND_API_KEY=
# Verified sender address, e.g. "Foundry <noreply@yourdomain.com>".
EMAIL_FROM=
# Where user feedback is forwarded (the product owner's inbox).
FEEDBACK_INBOX_EMAIL=

# ─── Analytics (PostHog, OPTIONAL — disabled when unset) ────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
