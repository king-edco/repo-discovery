{
  "name": "repo-discovery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "ingest": "node --env-file-if-exists=.env.local --import tsx src/scripts/ingest.ts",
    "verify-embeddings": "node --env-file-if-exists=.env.local --import tsx src/scripts/verify-embeddings.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@huggingface/transformers": "^4.2.0",
    "@octokit/plugin-paginate-rest": "^15.0.0",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/request-error": "^7.1.1",
    "@octokit/rest": "^22.0.1",
    "@serwist/next": "^9.5.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.16.2",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.20.0"
}
