# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# transformers.js model cache
.cache/

# ingestion resumable-progress marker
data/ingest-progress.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated service worker (Serwist)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map

# local SQLite database
/data/*.db
/data/*.db-wal
/data/*.db-shm

# OG preview image disk cache (regenerable from upstream)
/data/og-cache/

# agent + dev logs
/logs/
.agents_tmp/
